# Jira Cloud (use a dedicated bot account if you can)
JIRA_EMAIL=bot@example.com
JIRA_API_TOKEN=

# Optional: if unset, the bot falls back to `gh auth token`.
# Fine-grained PAT limited to the target repos: Contents (rw) + Pull requests (rw).
GITHUB_TOKEN=

# Optional: Slack incoming webhook for failure notifications and run summaries.
SLACK_WEBHOOK=
